{
  "name": "backend-csc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:contract": "tsx src/cli.ts contract",
    "check:local": "node scripts/smoke.mjs",
    "check:local-auth": "node scripts/check-local-auth.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^18.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
