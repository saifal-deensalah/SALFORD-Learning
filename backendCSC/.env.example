# Reference only. Do not overwrite existing environment files or data directories.
# Priority: process environment > .env > .env.local (first value wins).
# Active setup uses local PGlite; no external PostgreSQL credentials are required.
NODE_ENV=development
HOST=127.0.0.1
# Public local ports are shared in frontend/src/services/local-config.json.
# PORT=3000
# PUBLIC_API_ORIGIN=http://127.0.0.1:3000
DB_MODE=embedded
# Local email/password accounts need no activation email. Refused outside development + embedded + loopback.
# Default is false when omitted; automated tests ignore the machine setting.
LOCAL_EMAIL_AUTH=true
DATABASE_URL=
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_CA_FILE=
# Set an absolute private directory for this machine; DB lives in DATA_DIR/postgres.
# DATA_DIR=C:/Projects/CSCApp/backendCSC/.local/local-app
# Development generates a persistent random secret when APP_SECRET is absent.
# Production/Compose: generate with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# APP_SECRET=
REDIS_URL=
IN_PROCESS_WORKER=true

MAIL_MODE=local
# SMTP_URL=smtps://username:password@smtp.example.com:465
# SMTP_FROM=SALFORD <noreply@your-domain.com>
# AUTH_LINK_ORIGIN=https://your-domain.com

STORAGE_MODE=local
# S3_REGION=us-east-1
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT=https://your-s3-compatible-service
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FFMPEG_PATH=/usr/bin/ffmpeg
# CERTIFICATE_FONT=/path/to/licensed-unicode-font.ttf

# Billing is always simulated. There is no live-payment environment switch.
# GOOGLE_CLIENT_ID=web-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=optional-second-audience,optional-third-audience
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# GOOGLE_PACKAGE_NAME=com.cscapp
# APPLE_CLIENT_ID=com.example.app
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_KEY_FILE=/run/secrets/apple-sign-in.p8
# APPLE_BUNDLE_ID=com.example.app
# FCM_PROJECT_ID=

# Production admin routes are disabled unless explicitly enabled behind a private gateway.
ADMIN_API_ENABLED=false
# ADMIN_API_KEY=
# CORS_ORIGINS=https://admin.your-domain.com
